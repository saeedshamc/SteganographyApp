{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Stego",
  "version": "0.3.3",
  "identifier": "com.shams.openstego",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Stego",
        "width": 900,
        "height": 720,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Open-source steganography toolkit",
    "longDescription": "Hide encrypted payloads inside cover files and extract them later. Supports LSB for PNG/BMP and EOF append for other formats.",
    "publisher": "Saeed shamsi",
    "copyright": "Copyright (c) 2026 Saeed shamsi",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
